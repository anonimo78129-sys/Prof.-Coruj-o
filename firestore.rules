rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    // Admin via custom claim (`admin: true`) é o caminho preferido — atribuído
    // pelo Admin SDK, não fica exposto no bundle público e não depende de e-mail
    // fixo. Mantemos o e-mail de bootstrap e o role no doc como caminhos legados.
    function isClaimAdmin() {
      return request.auth.token.admin == true;
    }
    function isEmailAdmin() {
      return request.auth.token.email == "lyelsonmf520@gmail.com" && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let isDocAdmin = userDoc != null && userDoc.data.role == 'admin';
      return isAuthenticated() && (isClaimAdmin() || isEmailAdmin() || isDocAdmin);
    }

    // We create a specific rule for users where we don't call isAdmin if it's the owner,
    // to avoid recursive get()
    function isAdminWithoutGet() {
       return isAuthenticated() && (isClaimAdmin() || isEmailAdmin());
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function roleNotModified() {
      return !('role' in request.resource.data) || request.resource.data.role == resource.data.role;
    }
    function noPrivilegedRoleCreated() {
      return !('role' in request.resource.data) || request.resource.data.role != 'admin';
    }
    // Campos de cobrança: o dono não pode se dar PRO nem baixar o contador de
    // gerações (só incrementá-lo). Apenas admins escrevem esses campos livremente.
    //
    // `createdAt` marca o início do teste gratuito de 7 dias, então também é
    // imutável depois de gravado — sem isso bastaria reescrever a data para
    // renovar o teste indefinidamente. Ressalva conhecida: na criação do
    // documento a data ainda vem do cliente, então uma conta nova pode nascer
    // com data adiantada. Fechar isso exigiria carimbar a data no servidor.
    function billingFieldsProtected() {
      return (!('isPro' in request.resource.data) || request.resource.data.isPro == resource.data.get('isPro', false))
          && (!('generationsUsed' in request.resource.data) || request.resource.data.generationsUsed >= resource.data.get('generationsUsed', 0))
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.get('createdAt', request.resource.data.createdAt));
    }
    function noBillingPrivilegeCreated() {
      return (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
          && (!('generationsUsed' in request.resource.data) || request.resource.data.generationsUsed == 0);
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && uidUnchanged();
      allow read, update: if isAdmin();
      // O dono pode apagar o próprio feedback (direito de eliminação — LGPD
      // art. 18, VI; usado na exclusão de conta). Admin também pode.
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /library/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && (docId == 'announcement' || docId == 'feriados'));
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Admins can list the entire users collection (needed for admin panel onSnapshot).
      // We use isAdminWithoutGet() to avoid recursive get() calls per document during list queries.
      // Role-based admins are handled via a single get() here, not once per document.
      allow list: if isAdminWithoutGet() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // In their own document, we avoid the recursive get() by just checking if they are the owner,
      // or if they are the designated email admin. For other users, they check if they are an admin.
      allow get: if isOwner(userId) || isAdminWithoutGet() || (userId != request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // For create, resource does not exist.
      allow create: if (isOwner(userId) && uidUnchanged() && noPrivilegedRoleCreated() && noBillingPrivilegeCreated()) || isAdminWithoutGet() || (userId != request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // For update, they can update their own if they don't modify role/uid/billing, OR they are admin.
      // Use uidUnchanged() instead of uidNotModified() so owners can set uid even on old docs that lack it.
      allow update: if (isOwner(userId) && uidUnchanged() && roleNotModified() && billingFieldsProtected()) || isAdminWithoutGet() || (userId != request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      allow delete: if isOwner(userId) || isAdminWithoutGet() || (userId != request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Todas as subcoleções de dados do próprio usuário (schedules, classes,
      // resources, events, messages, studioMessages, notifications, fcmTokens,
      // gamification, diario, ...). O dono lê e escreve; ninguém mais acessa.
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && uidUnchanged();
        allow update: if isOwner(userId) && uidUnchanged();
        allow delete: if isOwner(userId);
      }
    }
  }
}
