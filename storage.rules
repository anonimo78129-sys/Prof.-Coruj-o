rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Library files: any authenticated user can read; only the email admin can write/delete
    match /library/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && request.auth.token.email == "lyelsonmf520@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
